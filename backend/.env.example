# Copy to .env and fill in. NEVER commit .env to GitHub.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
# Alert rule: ALERT_THRESHOLD reports of the same type within ALERT_RADIUS_M meters in ALERT_WINDOW_MIN minutes
ALERT_THRESHOLD=3
ALERT_RADIUS_M=1000
ALERT_WINDOW_MIN=60
MIN_CONFIDENCE=0.5
NOAA_STATION=8723214
# Protects /api/reset and /api/alerts/test (send header X-Admin-Token)
ADMIN_TOKEN=
