# Copy public frontend configuration to .env.local at the repository root.
# Supabase URL and anonymous key are read there by Vite; never add service-role keys.

# Base URL for read-only API calls. Empty means same origin.
VITE_API_BASE=

# Development proxy target for /api (defaults to http://localhost:8000).
# DEV_API_PROXY=http://localhost:8000

# Optional public CARTO basemaps key. Empty uses the keyless fallback.
VITE_CARTO_KEY=
