# Where "Go to the App" points. Used by every app CTA on the site (single source of truth).
# backend/main.py serves the app/ folder at /app, so in production this is usually "/app/"
# (same origin) or the full tunnel URL, e.g. https://<your-tunnel-host>/app/
VITE_APP_URL=/app/

# Base URL of the 4forces backend API (read-only endpoints: /api/health, /api/tide,
# /api/alerts/latest, /api/reports). Empty = same origin as the website.
VITE_API_BASE=

# Dev only: where `npm run dev` proxies /api requests (default http://localhost:8000)
# DEV_API_PROXY=http://localhost:8000
